# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# Database
MONGODB_URI=mongodb://localhost:27017/kuppam-organics
MONGODB_MAX_POOL_SIZE=15

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP / Email
# Required to send real emails. If omitted, emails are logged only (not sent).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional SMTP settings
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_POOL=false
# SMTP_CONNECTION_TIMEOUT=10000
# SMTP_GREETING_TIMEOUT=10000
# SMTP_IGNORE_TLS_ERRORS=false

# Sender identity (use EMAIL_FROM or the name/email pair below)
EMAIL_FROM="Kuppam Organics" <noreply@yourdomain.com>
# SMTP_FROM_NAME=Kuppam Organics
# SMTP_FROM_EMAIL=noreply@yourdomain.com
